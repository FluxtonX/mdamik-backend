# ─── Server ─────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/mdamik
FRONTEND_URL=https://your-flutter-app-deep-link

# ─── Firebase Admin SDK ──────────────────────────────
# Download serviceAccountKey.json from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ─── Stripe ──────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
# Get from: https://dashboard.stripe.com/webhooks → Add endpoint → signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ─── MyFawry ─────────────────────────────────────────
# Get from: https://developer.fawry.com
FAWRY_MERCHANT_CODE=xxxxxxxx
FAWRY_SECRET_KEY=xxxxxxxxxxxxxxxx
FAWRY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ─── Bangkok Bank ─────────────────────────────────────
# Get from Bangkok Bank developer portal
BANGKOK_BANK_MERCHANT_ID=xxxxxxxx
BANGKOK_BANK_SECRET=xxxxxxxxxxxxxxxx
BANGKOK_BANK_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# ─── Supported Currencies ─────────────────────────────
# USD = US Dollar        (Stripe ✅ / Fawry ✅ / BKB ✅ / COD ✅)
# SAR = Saudi Riyal      (Stripe ✅ / COD ✅)
# SDG = Sudanese Pound   (Stripe ❌ — use Fawry or COD)
# EGP = Egyptian Pound   (Stripe ✅ / Fawry ✅)
# THB = Thai Baht        (Stripe ✅ / BKB ✅)
